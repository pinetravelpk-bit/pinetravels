# ── Public site URL (canonical domain) ────────────────────────
# Sitemap, robots.txt, canonical tags aur JSON-LD schema isi ko use karte hain.
# Bina protocol ke slash nahi — bas https://your-domain
NEXT_PUBLIC_SITE_URL=https://pinetravel.pk

# ── Database (Hostinger hPanel > Databases > Management) ──────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u123456789_pinetravel
DB_USER=u123456789_pine
DB_PASSWORD=your-database-password

# ── Admin login ───────────────────────────────────────────────
# `npm run setup` chalane par ye user ban jata hai.
ADMIN_EMAIL=admin@pinetravels.com
ADMIN_NAME=Pine Travel
ADMIN_PASSWORD=change-this-password

# ── Session security ──────────────────────────────────────────
# Koi bhi lamba random text. Badalne se sab log out ho jayenge.
AUTH_SECRET=change-this-to-a-long-random-string

# ── Uploads ───────────────────────────────────────────────────
# Images/videos yahan save hote hain. Khali chhod dein to public/uploads.
# UPLOAD_DIR=/home/uXXXX/uploads
